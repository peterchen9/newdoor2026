# Copy to .env and replace both tokens with different random values (minimum 24 characters).
# Set true for LAN testing without a key or phone pairing code; false restores authentication.
TEST_NO_AUTH=false
HOST_TOKEN=replace-with-random-host-token
DOOR_TOKEN=replace-with-random-door-token
CONTACT_TEXT=目前無人接聽，請聯絡管理員（請填入聯絡電話）。
RING_SECONDS=30
CALL_SECONDS=180
# mock never operates a physical lock. http requires a trusted pulse-controller API.
RELAY_MODE=mock
# RELAY_URL=https://controller.example/pulse
# RELAY_TOKEN=replace-with-controller-token
RELAY_PULSE_MS=3000
